# Copy this file to `chatterbox-server.env` and adjust for your server.

CHATTERBOX_MODEL_VARIANT=multilingual
CHATTERBOX_GPU_MEMORY_UTILIZATION=0.5
CHATTERBOX_MAX_BATCH_SIZE=10
CHATTERBOX_MAX_MODEL_LEN=500
CHATTERBOX_SPLIT_SENTENCES_DEFAULT=true
CHATTERBOX_CONDS_CACHE_SIZE=32
CHATTERBOX_COMPILE=false
CHATTERBOX_API_BATCH_COLLECT_MS=10
CHATTERBOX_API_MAX_BATCH_REQUESTS=10
CHATTERBOX_API_MAX_BATCH_PROMPTS=10

CHATTERBOX_API_HOST=0.0.0.0
CHATTERBOX_API_PORT=8000

PYTHONUNBUFFERED=1
VLLM_WORKER_MULTIPROC_METHOD=spawn
